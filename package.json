{
  "name": "pm4Ps2",
  "title": "Princess Maker 4 (PS2) Parser",
  "description": "Translate Japanese PS2 Princess Maker 4 text, mod CGs and other artwork, and export a separate patched ISO with an optional English name-entry keyboard.",
  "main": "pm4Ps2.js",
  "homepage": "https://github.com/pismax",
  "version": "0.5.1",
  "icon": "icon-portrait.png",
  "author": {
    "name": "pismax"
  },
  "autoload": false,
  "load": [
    "pm4Ps2.js"
  ],
  "minimumVersion": "8.10.29",
  "compile": {
    "modules": [
      "pm4Ps2.module.js",
      "pm4Ps2.images.js",
      "pm4Ps2.keyboard.js",
      "pm4Ps2.image-ui.js"
    ]
  },
  "exclude": [
    "src/**",
    "test/**",
    "plan/**",
    "showcase/**",
    "AGENTS.md",
    "README.md",
    "pm4Ps2.worker.js"
  ]
}
